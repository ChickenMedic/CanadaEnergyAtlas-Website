<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:oel="http://schemas.microsoft.com/office/2019/extlst" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16du="http://schemas.microsoft.com/office/word/2023/wordml/word16du" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="38C5E5CC" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Deep Dive: The Arteries of North American Energy</w:t></w:r></w:p><w:p w14:paraId="1B0DA0FF" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Part 1: The Liquids Pipeline Network</w:t></w:r></w:p><w:p w14:paraId="74E620F6" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:r w:rsidRPr="008B13C0"><w:t>Canada holds the world’s third-largest oil reserves, but its greatest challenge is geography. The Western Canadian Sedimentary Basin (WCSB) is landlocked, making pipeline "takeaway capacity" the lifeblood of the Canadian economy.</w:t></w:r></w:p><w:p w14:paraId="3B8B84C3" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>1. The Enbridge Mainline: The Continent’s Heavy Lifter</w:t></w:r></w:p><w:p w14:paraId="72710F5E" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:r w:rsidRPr="008B13C0"><w:t>The Enbridge Mainline is the largest and most complex pipeline system in the world. It isn't just a single pipe; it is a massive network of lines that carry both light and heavy crude, as well as natural gas liquids (NGLs).</w:t></w:r></w:p><w:p w14:paraId="766783E1" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>The Hub:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> Starting in Edmonton, Alberta, it travels through the Canadian prairies before crossing into the U.S. at Gretna, Manitoba, where it becomes the </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Lakehead System</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t>.</w:t></w:r></w:p><w:p w14:paraId="7C3B3CF4" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Economic Impact:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> This system serves as the primary supplier for refineries in the </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>U.S. Midwest (PADD II)</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> and Ontario. Without the Mainline, fuel prices across the American Midwest would fluctuate wildly, as it provides the feedstock for everything from gasoline to jet fuel.</w:t></w:r></w:p><w:p w14:paraId="079E6457" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>2. Trans Mountain (TMX): A Strategic Shift to Tidewater</w:t></w:r></w:p><w:p w14:paraId="627C0F48" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:r w:rsidRPr="008B13C0"><w:t>For decades, Canada was almost entirely dependent on the U.S. as its only customer. The completion of the Trans Mountain Expansion (TMX) in 2024 fundamentally changed this.</w:t></w:r></w:p><w:p w14:paraId="4C632767" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Capacity Leap:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> The project "twinned" the existing line, jumping capacity from 300,000 bpd to </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>890,000 bpd</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t>.</w:t></w:r></w:p><w:p w14:paraId="12EB89FD" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Global Reach:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> By terminating at the Westridge Marine Terminal in Burnaby, BC, Canadian oil can now reach California and Asian markets (China, India, South Korea). This "tidewater access" helps reduce the price discount on Canadian oil (WCS) compared to American oil (WTI).</w:t></w:r></w:p><w:p w14:paraId="71197424" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>3. Keystone Pipeline: The North-South Bond</w:t></w:r></w:p><w:p w14:paraId="788982FC" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve">TC Energy’s Keystone Pipeline (not to be confused with the cancelled Keystone XL) is a critical link to the </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>U.S. Gulf Coast (PADD III)</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t>.</w:t></w:r></w:p><w:p w14:paraId="4E72EBC4" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Refining Match:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> The U.S. Gulf Coast has some of the world’s most sophisticated "complex" refineries designed specifically to process heavy Canadian crude. This makes the U.S. Gulf a natural partner for Alberta’s oil sands.</w:t></w:r></w:p><w:p w14:paraId="29CB9F89" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:r w:rsidRPr="008B13C0"><w:pict w14:anchorId="6D31B71F"><v:rect id="_x0000_i1043" style="width:0;height:1.5pt" o:hralign="center" o:hrstd="t" o:hr="t" fillcolor="#a0a0a0" stroked="f"/></w:pict></w:r></w:p><w:p w14:paraId="03B422BD" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Part 2: Natural Gas Flows &amp; The LNG Revolution</w:t></w:r></w:p><w:p w14:paraId="30A56994" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:r w:rsidRPr="008B13C0"><w:t>While oil gets the headlines, Canada's natural gas system is a marvel of engineering that spans the continent.</w:t></w:r></w:p><w:p w14:paraId="54D02017" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>1. The NGTL System: The Heart of Gathering</w:t></w:r></w:p><w:p w14:paraId="4F6BFD94" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:r w:rsidRPr="008B13C0"><w:lastRenderedPageBreak/><w:t xml:space="preserve">The </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Nova Gas Transmission Ltd. (NGTL)</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> system is the most significant gathering and transportation network in Canada.</w:t></w:r></w:p><w:p w14:paraId="7CEBEDD4" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Scale:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> With a capacity of </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>11.2 Bcf/d</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t>, it collects gas from thousands of wells in the WCSB.</w:t></w:r></w:p><w:p w14:paraId="020FE0C5" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>The AECO Hub:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> This system forms the basis for the AECO trading hub, the primary price benchmark for natural gas in Western Canada.</w:t></w:r></w:p><w:p w14:paraId="362E97B2" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>2. Coastal GasLink &amp; LNG Canada: Entering the Global Stage</w:t></w:r></w:p><w:p w14:paraId="347E4F00" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve">Until recently, Canadian gas could only travel via pipe to North American neighbors. The </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Coastal GasLink</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> pipeline changes that.</w:t></w:r></w:p><w:p w14:paraId="6CA97A7B" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>The Route:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> It travels 670 km from northeastern B.C. to the </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>LNG Canada</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> facility in Kitimat.</w:t></w:r></w:p><w:p w14:paraId="3CCCA576" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Liquid Transformation:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> At the terminal, gas is cooled to -162°C, shrinking it 600 times in volume into a liquid (LNG) so it can be loaded onto massive tankers.</w:t></w:r></w:p><w:p w14:paraId="11F4858C" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Environmental Context:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> Canadian LNG is marketed as a lower-carbon alternative to coal for power generation in Asia, potentially playing a role in global emissions reduction.</w:t></w:r></w:p><w:p w14:paraId="6CB411FD" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:r w:rsidRPr="008B13C0"><w:pict w14:anchorId="274B1514"><v:rect id="_x0000_i1044" style="width:0;height:1.5pt" o:hralign="center" o:hrstd="t" o:hr="t" fillcolor="#a0a0a0" stroked="f"/></w:pict></w:r></w:p><w:p w14:paraId="532317B6" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Visual Recommendations for Your Website</w:t></w:r></w:p><w:p w14:paraId="04518440" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Interactive Flow Map:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> A map where users can click on a pipeline (like TMX or Enbridge) and see a highlight of which refineries or cities it serves in both the US and Canada.</w:t></w:r></w:p><w:p w14:paraId="464B4AA4" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Capacity Bar Chart:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> A side-by-side comparison showing the 2020 export capacity vs. the 2025 export capacity to show the growth from TMX and Coastal GasLink.</w:t></w:r></w:p><w:p w14:paraId="517B42AE" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>"Day in the Life" of a Barrel:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> An infographic showing a barrel of oil starting in Fort McMurray, traveling through the Mainline, being refined in Illinois, and ending up as gas in a car in Chicago.</w:t></w:r></w:p><w:p w14:paraId="00B9E388" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:r w:rsidRPr="008B13C0"><w:pict w14:anchorId="06745AA3"><v:rect id="_x0000_i1045" style="width:0;height:1.5pt" o:hralign="center" o:hrstd="t" o:hr="t" fillcolor="#a0a0a0" stroked="f"/></w:pict></w:r></w:p><w:p w14:paraId="765A9578" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Sources</w:t></w:r></w:p><w:p w14:paraId="0C251E39" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Canada Energy Regulator (CER):</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:i/><w:iCs/></w:rPr><w:t>Pipeline Profiles &amp; Energy Future 2023 Report.</w:t></w:r></w:p><w:p w14:paraId="070538DE" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>U.S. Energy Information Administration (EIA):</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:i/><w:iCs/></w:rPr><w:t>Canada Country Analysis Brief.</w:t></w:r></w:p><w:p w14:paraId="6E634D0D" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>TC Energy:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:i/><w:iCs/></w:rPr><w:t>NGTL System and Coastal GasLink Project Factsheets.</w:t></w:r></w:p><w:p w14:paraId="728FD299" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Enbridge Inc.:</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:i/><w:iCs/></w:rPr><w:t>Mainline System Operations and Lakehead Expansion Data.</w:t></w:r></w:p><w:p w14:paraId="128F208F" w14:textId="77777777" w:rsidR="008B13C0" w:rsidRPr="008B13C0" w:rsidRDefault="008B13C0" w:rsidP="008B13C0"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r w:rsidRPr="008B13C0"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Canadian Association of Petroleum Producers (CAPP):</w:t></w:r><w:r w:rsidRPr="008B13C0"><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="008B13C0"><w:rPr><w:i/><w:iCs/></w:rPr><w:t>2023 Statistical Handbook for the Canadian Oil and Gas Industry.</w:t></w:r></w:p><w:p w14:paraId="1EFF4E5F" w14:textId="77777777" w:rsidR="00C121AE" w:rsidRDefault="00C121AE"/><w:sectPr w:rsidR="00C121AE"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="708"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>